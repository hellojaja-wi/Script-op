-- Hàm kiểm tra người chơi có sở hữu vật phẩm không
local function hasTool(toolName)
    local backpack = localPlayer:FindFirstChild("Backpack")
    local character = localPlayer.Character
    
    if backpack and backpack:FindFirstChild(toolName) then
        return true
    end
    if character and character:FindFirstChild(toolName) then
        return true
    end
    return false
end

-- Hàm tìm danh sách vật phẩm đang bị thiếu
local function getMissingTools()
    local missing = {}
    for _, toolName in ipairs(requiredTools) do
        if not hasTool(toolName) then
            table.insert(missing, toolName)
        end
    end
    return missing
end

-- Vòng lặp Smart Auto Check & Claim Items
task.spawn(function()
    while true do
        if autoSmartItemsEnabled then
            pcall(function()
                local missingTools = getMissingTools()
                
                -- Nếu phát hiện thiếu ít nhất 1 vật phẩm
                if #missingTools > 0 then
                    local char = localPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    
                    if hrp then
                        -- 1. Lưu lại vị trí đứng cuối cùng trước khi bị dịch chuyển
                        local originalCFrame = hrp.CFrame
                        
                        -- 2. Dịch chuyển lấy từng vật phẩm thiếu
                        for _, toolName in ipairs(missingTools) do
                            local itemGiver = workspace:FindFirstChild(toolName, true) or workspace:FindFirstChild(toolName .. "Giver", true)
                            if itemGiver then
                                local targetCFrame = itemGiver:IsA("BasePart") and itemGiver.CFrame or itemGiver:GetPivot()
                                hrp.CFrame = targetCFrame * CFrame.new(0, 3, 0)
                                task.wait(0.25)
                            end
                            
                            -- Bắn Remote lấy đồ
                            mapRemote:FireServer("claimTool", toolName)
                            task.wait(0.25)
                        end
                        
                        -- 3. Kiểm tra tổng quát lại một lần nữa
                        task.wait(0.2)
                        local recheckMissing = getMissingTools()
                        
                        -- 4. Nếu đã lấy đủ (hoặc xong lượt) -> Quay về vị trí cũ ngay lập tức
                        if hrp and hrp.Parent then
                            hrp.CFrame = originalCFrame
                        end
                    end
                end
            end)
            task.wait(2) -- Kiểm tra lại túi đồ mỗi 2 giây
        else
            task.wait(1)
        end
    end
end)

-- Loop Auto 8k Coins (90s Cooldown)
task.spawn(function()
    while true do
        if autoClaimCoinsEnabled then
            pcall(function()
                local char = localPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local lastCFrame = hrp.CFrame
                    local targetGiver = workspace:FindFirstChild("8kCoinsGiver", true)
                    if targetGiver then
                        local targetCFrame = targetGiver:IsA("BasePart") and targetGiver.CFrame or targetGiver:GetPivot()
                        hrp.CFrame = targetCFrame * CFrame.new(0, 3, 0)
                        task.wait(0.25)
                    end
                    mapRemote:FireServer("claimCoins", "8kCoinsGiver")
                    task.wait(0.2)
                    hrp.CFrame = lastCFrame
                end
            end)
            task.wait(90)
        else
            task.wait(1)
        end
    end
end)

